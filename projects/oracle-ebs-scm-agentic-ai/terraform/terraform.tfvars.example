project_id       = "your-project"
region           = "your-region"
vpc_network_name = "your-vpc-network"
subnet_name      = "your-subnet-name"
oracle_host      = "your-oracle-ebs-db-private-ip"

# Responsibility keys of the confirmed writebacks: the Vision keys that
# ebs-scripts/install_voltguard_agent_user.sql assigns. Keep both equal.
ebs_inventory_responsibility  = "INVENTORY_VISION_OPERATIONS"
ebs_purchasing_responsibility = "PURCHASING_OPERATIONS"

# Passwords. Without them, deploy_stack.sh reads them from Secret Manager or
# prompts for them:
# oracle_db_password     = "your-apps-ai-password"
# ebs_writeback_password = "your-voltguard-agent-password"
