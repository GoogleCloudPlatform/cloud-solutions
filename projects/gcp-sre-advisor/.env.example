REQUIRE_DELEGATED_USER_OAUTH=false

TARGET_PROJECT_ID=your-target-project-id
TARGET_REGION=us-central1
TARGET_ZONE=us-central1-a

DATABASE_MCP_TOOLBOX_URL=
