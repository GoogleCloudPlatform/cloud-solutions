# ── Google Cloud Configuration ─────────────────────────────
# Your GCP project ID (required)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region for ADK agent deployment (default: us-central1)
# Note: Gemini, Omni, Veo, and Lyria API calls use location="global"
GOOGLE_CLOUD_LOCATION=us-central1

# ── Video Model (optional) ─────────────────────────────────
# Veo model version (default: veo-3.1-generate-001)
# VIDEO_GENERATION_MODEL=veo-3.1-generate-001
# Default video duration in seconds for Omni and Veo (default: 8)
# VIDEO_DEFAULT_DURATION=8
