# Cymbal Pooled Multi-Tenant Agentic AI — Local & Cloud Environment Template
# Without `.env`, the Web UI and all hermetic tests run locally without GCP access.

# Optional: Set CYMBAL_LIVE_GCP=1 and your GCP Project ID to enable live GCP API calls
CYMBAL_LIVE_GCP=0
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# Optional Phase 2: 3rd-Party Enterprise Connectors (OFFLINE SANDBOX ONLY; live reads Secret Manager)
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=admin@your-org.com
JIRA_PROJECT_KEY=FINVAULT

SERVICENOW_CORRELATION_ID=ROA-2026-8812
SERVICENOW_INSTANCE_URL=https://dev000000.service-now.com
SERVICENOW_PASSWORD=your-servicenow-password
SERVICENOW_USERNAME=admin

AZURE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_ENTRA_CLIENT_SECRET=your-entra-client-secret
AZURE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional Hop 0 (ADR-0009): Google Identity Platform broker (multi-tenancy enabled)
IDENTITY_PLATFORM_PROJECT_ID=your-identity-platform-project-id

# Optional Hop 0 fallback: direct federation with a tenant Okta authorization server
OKTA_AUDIENCE=0oa-your-agent-gateway-client-id
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
