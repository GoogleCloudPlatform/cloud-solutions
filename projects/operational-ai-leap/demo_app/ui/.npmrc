# package.json mixes Angular v20 packages (with typescript ~5.8.0 and
# zone.js ~0.14.0) with @angular/core and @angular-devkit/build-angular v22
# from security updates, and @angular/* packages declare exact-version peer
# dependencies on one another. Match the `npm ci --legacy-peer-deps` flag in
# ../Dockerfile so `npm install` and automated Renovate/Dependabot lockfile
# updates do not fail with ERESOLVE when patching individual packages.
legacy-peer-deps=true
