{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MigrationState",
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": ["PHASE_2", "PHASE_3_4", "PHASE_5", "PHASE_6"]
    },
    "chosen_cluster_name": { "type": "string" },
    "chosen_cluster_location": { "type": "string" },
    "target_ingresses": {
      "type": "array",
      "items": { "type": "object" }
    },
    "gateway_yaml": { "type": "string" },
    "action": {
      "type": "string",
      "enum": ["APPROVE", "DECLINE", "CANCEL"]
    }
  },
  "required": ["phase"],
  "additionalProperties": false
}
