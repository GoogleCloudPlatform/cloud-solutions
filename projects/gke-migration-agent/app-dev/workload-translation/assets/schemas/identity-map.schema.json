{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "identity-map",
  "title": "Identity Map Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "source",
      "target"
    ],
    "properties": {
      "source": {
        "type": "string",
        "description": "The AWS IAM Role ARN"
      },
      "target": {
