{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storage-map",
  "title": "Storage Map Schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "source": {
        "type": "string",
        "description": "The AWS StorageClass name"
      },
      "source_provisioner": {
        "type": "string",
        "description": "The AWS provisioner (e.g., ebs.csi.aws.com)"
      },
      "target": {
        "type": "string",
        "description": "The GKE StorageClass name"
      },
      "target_provisioner": {
        "type": "string",
        "description": "The GKE provisioner (e.g., pd.csi.storage.gke.io)"
      }
    },
    "required": [
      "source",
      "source_provisioner",
      "target",
      "target_provisioner"
    ],
    "additionalProperties": false
  }
}
